<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:OmniBrille.Desktop.Rendering"
        x:Class="OmniBrille.Desktop.MainWindow"
        x:CompileBindings="False"
        Title="OmniBrille — Structure"
        FontSize="13"
        Width="980"
        Height="600"
        MinWidth="820"
        MinHeight="520"
        Icon="/Assets/OmniBrille.ico"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid x:Name="HeaderLayout" RowDefinitions="Auto,Auto" RowSpacing="8">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,8,*,Auto" ColumnSpacing="8">
        <Button x:Name="ChooseFolderButton"
                Grid.Column="0"
                Classes="hud"
                Click="OnChooseFolderClick"
                AutomationProperties.Name="Choose an access folder"
                AutomationProperties.HelpText="Selects the only filesystem root OmniBrille may inspect.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="ROOT" FontSize="9" LetterSpacing="1.2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Choose" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="BackButton"
                Grid.Column="1"
                Classes="hud"
                Click="OnBackClick"
                IsEnabled="False"
                Content="← Back"
                AutomationProperties.Name="Navigate back"
                AutomationProperties.HelpText="Returns to the aggregate overview or previous folder." />

        <Grid Grid.Column="3" ColumnDefinitions="*,Auto" MinWidth="160" MaxWidth="520" HorizontalAlignment="Stretch">
          <TextBox x:Name="SearchBox"
                   Grid.Column="0"
                   Classes="hud"
                   PlaceholderText="Search selected root"
                   KeyDown="OnSearchKeyDown"
                   AutomationProperties.Name="Structural search"
                   AutomationProperties.HelpText="Searches only names and paths inside the selected root. Press Escape to clear." />
          <Button x:Name="SearchButton"
                  Grid.Column="1"
                  Classes="hud"
                  Margin="6,0,0,0"
                  Content="Search"
                  Click="OnSearchClick"
                  AutomationProperties.Name="Run structural search" />
        </Grid>

        <Button x:Name="ConnectionButton"
                Grid.Column="4"
                Classes="hud"
                Content="Standalone"
                Click="OnConnectionClick"
                AutomationProperties.Name="Provider connection status"
                AutomationProperties.HelpText="Shows whether navigation is standalone or supplied by OmniSorSe."
                AutomationProperties.LiveSetting="Polite" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
          <RadioButton x:Name="StructureModeButton"
                       Classes="hud"
                       Content="Structure"
                       GroupName="ExplorerMode"
                       IsChecked="True"
                       Click="OnStructureModeClick"
                       IsCheckedChanged="OnStructureModeCheckedChanged"
                       AutomationProperties.Name="Structure mode"
                       AutomationProperties.HelpText="Shows indexed filesystem containment." />
          <RadioButton x:Name="ContextModeButton"
                       Classes="hud"
                       Content="Context"
                       GroupName="ExplorerMode"
                       Click="OnContextModeClick"
                       IsCheckedChanged="OnContextModeCheckedChanged"
                       AutomationProperties.Name="Context mode"
                       AutomationProperties.HelpText="Shows bounded relationships authored by OmniSorSe. Requires a connected session." />
          <RadioButton x:Name="HybridModeButton"
                       Classes="hud"
                       Content="Hybrid"
                       GroupName="ExplorerMode"
                       Click="OnHybridModeClick"
                       IsCheckedChanged="OnHybridModeCheckedChanged"
                       AutomationProperties.Name="Hybrid mode"
                       AutomationProperties.HelpText="Combines bounded structural orientation with relationships authored by OmniSorSe. Requires a connected session. Control 3." />
          <Button x:Name="ContextFilterButton"
                  Classes="hud compact"
                  IsVisible="False"
                  Content="Filter"
                  Click="OnContextFilterClick"
                  AutomationProperties.Name="Open Context filters"
                  AutomationProperties.HelpText="Filters the current authorized relationship response by kind, strength, or evidence. Ctrl+Shift+F." />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Classes="hud" Content="-" Click="OnZoomOutClick" ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom out" />
          <Button Classes="hud" Content="0" Click="OnResetViewClick" ToolTip.Tip="Reset view" AutomationProperties.Name="Reset graph view" />
          <Button Classes="hud" Content="+" Click="OnZoomInClick" ToolTip.Tip="Zoom in" AutomationProperties.Name="Zoom in" />
        </StackPanel>

        <ComboBox x:Name="ThemePicker"
                  Grid.Column="3"
                  Classes="hud"
                  Width="104"
                  SelectedIndex="0"
                  SelectionChanged="OnThemeChanged"
                  AutomationProperties.Name="Theme"
                  AutomationProperties.HelpText="Switches between Dark and Light themes.">
          <ComboBoxItem Content="Dark" />
          <ComboBoxItem Content="Light" />
        </ComboBox>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
          <Button x:Name="AccessibleListButton"
                  Classes="hud"
                  Content="List"
                  Click="OnAccessibleListClick"
                  AutomationProperties.Name="Open accessible navigation list"
                  AutomationProperties.HelpText="Opens a keyboard and screen-reader friendly view of the same bounded graph scene." />

          <Button x:Name="SettingsButton"
                  Classes="hud"
                  Content="Settings"
                  Click="OnSettingsClick"
                  AutomationProperties.Name="Visual settings" />
        </StackPanel>
      </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <rendering:GraphSceneControl x:Name="GraphScene"
                                   AutomationProperties.Name="Spatial Structure graph"
                                   AutomationProperties.HelpText="Use arrow keys to select nodes, Enter to activate, Backspace to go back, plus or minus to zoom, and drag empty space to pan." />

      <Border x:Name="FocusHud"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,14,0,0"
              Padding="24,7"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="3">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="CURRENT FOCUS"
                     FontSize="9"
                     LetterSpacing="1.8"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="CurrentPathText"
                     Text="No folder selected"
                     FontSize="14"
                     FontWeight="SemiBold"
                     MaxWidth="680"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border x:Name="ProgressHud"
              IsVisible="False"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,73,0,0"
              Padding="12,5"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource AccentSoftBrush}"
              BorderThickness="1"
              CornerRadius="3"
              AutomationProperties.Name="Graph loading status">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <ProgressBar Width="62" Height="2" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock x:Name="ProgressText" Text="Reading structural items…" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Button Classes="hud compact" Content="Cancel" Click="OnCancelClick" AutomationProperties.Name="Cancel loading or search" />
        </StackPanel>
      </Border>

      <Border x:Name="VoiceHud"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,18"
              Padding="9,6"
              MaxWidth="760"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              AutomationProperties.Name="Voice input">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <Border x:Name="VoiceListeningRing"
                  Width="12"
                  Height="12"
                  CornerRadius="6"
                  BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="2"
                  Background="{DynamicResource AccentSoftBrush}"
                  AutomationProperties.Name="Microphone activity indicator" />
          <Button x:Name="VoiceButton"
                  Grid.Column="1"
                  Classes="hud compact"
                  Content="Voice off"
                  Click="OnVoiceButtonClick"
                  AutomationProperties.Name="Push to talk"
                  AutomationProperties.HelpText="Configure local voice in Settings. Control Shift Space toggles push to talk." />
          <ProgressBar x:Name="VoiceLevelIndicator"
                       Grid.Column="2"
                       Width="54"
                       Height="3"
                       Minimum="0"
                       Maximum="1"
                       Value="0"
                       Foreground="{DynamicResource AccentBrush}"
                       AutomationProperties.Name="Microphone level" />
          <StackPanel Grid.Column="3" MaxWidth="430" VerticalAlignment="Center">
            <TextBlock x:Name="VoiceStateText"
                       Text="Voice is off."
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="VoiceTranscriptText"
                       IsVisible="False"
                       FontSize="10"
                       Foreground="{DynamicResource AccentBrush}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Recognized voice transcript"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <Button x:Name="VoiceCancelButton"
                  Grid.Column="4"
                  IsVisible="False"
                  Classes="hud compact"
                  Content="Cancel"
                  Click="OnVoiceCancelClick"
                  AutomationProperties.Name="Cancel voice capture or transcription" />
        </Grid>
      </Border>

      <Border x:Name="ConnectionPanel"
              IsVisible="False"
              Width="360"
              MaxHeight="430"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,82,16,0"
              Padding="14"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              AutomationProperties.Name="OmniSorSe connection">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="PROVIDER" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource AccentBrush}" />
            <Button Grid.Column="1" Classes="hud compact" Content="×" Click="OnConnectionClick" AutomationProperties.Name="Close connection panel" />
          </Grid>
          <TextBlock x:Name="ConnectionStatusText"
                     Text="Standalone"
                     FontSize="15"
                     FontWeight="SemiBold"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="ConnectionDescriptionText"
                     Text="Choose a folder for explicit standalone access. A compatible OmniSorSe release can launch OmniBrille through an authorized one-time handoff."
                     TextWrapping="Wrap"
                     FontSize="10"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <ComboBox x:Name="ConnectedRootPicker"
                    Classes="hud"
                    IsVisible="False"
                    AutomationProperties.Name="OmniSorSe accessible roots"
                    AutomationProperties.HelpText="Contains only indexed roots authorized by OmniSorSe." />
          <Button x:Name="OpenConnectedRootButton"
                  Classes="hud"
                  IsVisible="False"
                  Content="Open authorized root"
                  Click="OnOpenConnectedRootClick"
                  AutomationProperties.Name="Open selected OmniSorSe root" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="ReconnectButton"
                    Classes="hud"
                    Content="Retry connection"
                    Click="OnReconnectClick"
                    AutomationProperties.Name="Retry OmniSorSe connection" />
            <Button x:Name="UseStandaloneButton"
                    Grid.Column="1"
                    Classes="hud"
                    Content="Use standalone"
                    Click="OnUseStandaloneClick"
                    AutomationProperties.Name="Switch to standalone mode" />
          </Grid>
        </StackPanel>
      </Border>

      <Border x:Name="SearchResultsPanel"
              IsVisible="False"
              Width="350"
              MaxHeight="410"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="16,82,0,0"
              Padding="12"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              AutomationProperties.Name="Search results">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="SearchSummaryText" Text="Search results" FontWeight="SemiBold" Margin="4,2,4,8" />
            <Button Grid.Column="1" Classes="hud compact" Content="×" Click="OnCloseSearchClick" AutomationProperties.Name="Close search results" />
          </Grid>
          <ListBox x:Name="SearchResultsList"
                   Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   DoubleTapped="OnSearchResultDoubleTapped"
                   KeyDown="OnSearchResultsKeyDown"
                   AutomationProperties.Name="Structural search results">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,6" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="1" Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="SearchEmptyState"
                      Grid.Row="1"
                      IsVisible="False"
                      Margin="8,18"
                      Spacing="7"
                      AutomationProperties.Name="No Search matches">
            <TextBlock Text="NO MATCHES" FontSize="10" LetterSpacing="1.4" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="No items match this query in the current Search scope. Edit the query or press Escape to clear."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
          <Button x:Name="FocusSearchResultButton"
                  Grid.Row="2"
                  Classes="hud"
                  Margin="4,8,4,2"
                  Content="Focus selected result"
                  Click="OnFocusSearchResultClick"
                  AutomationProperties.Name="Focus selected Search result" />
        </Grid>
      </Border>

      <Border x:Name="ContextFilterPanel"
              IsVisible="False"
              Width="310"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="16,82,0,0"
              Padding="14"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              AutomationProperties.Name="Context relationship filters">
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="CONTEXT FILTERS" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource AccentBrush}" />
            <Button Grid.Column="1" Classes="hud compact" Content="×" Click="OnContextFilterClick" AutomationProperties.Name="Close Context filters" />
          </Grid>
          <TextBlock x:Name="ContextFilterSummaryText"
                     Text="Authoritative relationships"
                     TextWrapping="Wrap"
                     FontSize="10"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="Relationship kind" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
          <ComboBox x:Name="ContextKindFilter"
                    Classes="hud"
                    SelectedIndex="0"
                    SelectionChanged="OnContextFilterChanged"
                    AutomationProperties.Name="Relationship kind filter">
            <ComboBoxItem Content="All kinds" />
            <ComboBoxItem Content="Related" />
            <ComboBoxItem Content="Topic" />
            <ComboBoxItem Content="Entity" />
            <ComboBoxItem Content="Temporal" />
            <ComboBoxItem Content="OCR" />
            <ComboBoxItem Content="Transcript" />
          </ComboBox>
          <TextBlock Text="Minimum strength" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
          <ComboBox x:Name="ContextStrengthFilter"
                    Classes="hud"
                    SelectedIndex="0"
                    SelectionChanged="OnContextFilterChanged"
                    AutomationProperties.Name="Minimum relationship strength filter"
                    AutomationProperties.HelpText="Strength is OmniSorSe ranking strength, not statistical confidence.">
            <ComboBoxItem Content="All retained" />
            <ComboBoxItem Content="Moderate · 60+" />
            <ComboBoxItem Content="Strong · 80+" />
            <ComboBoxItem Content="Confirmed · 100" />
          </ComboBox>
          <TextBlock Text="Evidence" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
          <ComboBox x:Name="ContextEvidenceFilter"
                    Classes="hud"
                    SelectedIndex="0"
                    SelectionChanged="OnContextFilterChanged"
                    AutomationProperties.Name="Relationship evidence filter">
            <ComboBoxItem Content="All evidence" />
            <ComboBoxItem Content="Deterministic" />
            <ComboBoxItem Content="Derived" />
          </ComboBox>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,4,0,0">
            <Button x:Name="ClearContextFiltersButton"
                    Classes="hud"
                    Content="Reset"
                    Click="OnClearContextFiltersClick"
                    AutomationProperties.Name="Reset Context filters" />
            <Button Grid.Column="1"
                    Classes="hud"
                    Content="Close"
                    Click="OnContextFilterClick"
                    AutomationProperties.Name="Close Context filters" />
          </Grid>
        </StackPanel>
      </Border>

      <Border x:Name="AccessibleListPanel"
              IsVisible="False"
              Width="370"
              MaxHeight="450"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="16,82,0,0"
              Padding="12"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              AutomationProperties.Name="Accessible graph navigation">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="ACCESSIBLE NAVIGATION" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource AccentBrush}" />
            <Button Grid.Column="1" Classes="hud compact" Content="×" Click="OnAccessibleListClick" AutomationProperties.Name="Close accessible navigation list" />
          </Grid>
          <StackPanel Grid.Row="1" Margin="4,8,4,7">
            <TextBlock Text="CURRENT FOCUS" FontSize="9" LetterSpacing="1.2" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock x:Name="AccessibleFocusText" Text="No folder selected" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ListBox x:Name="AccessibleNodesList"
                   Grid.Row="2"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectionChanged="OnAccessibleNodeSelectionChanged"
                   DoubleTapped="OnAccessibleNodeDoubleTapped"
                   AutomationProperties.Name="Visible graph nodes"
                   AutomationProperties.HelpText="Use arrows to select, Enter to open, and Backspace to return.">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,5" RowDefinitions="Auto,Auto" AutomationProperties.Name="{Binding AccessibleName}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Margin="8,0,0,0" FontSize="9" Foreground="{DynamicResource AccentBrush}" />
                  </Grid>
                  <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="3" ColumnDefinitions="*,*,Auto" ColumnSpacing="6" Margin="4,8,4,2">
            <Button x:Name="AccessibleBackButton" Classes="hud" Content="Back" Click="OnBackClick" AutomationProperties.Name="Navigate back from accessible list" />
            <Button x:Name="AccessibleOpenButton" Grid.Column="1" Classes="hud" Content="Open selected" Click="OnOpenAccessibleNodeClick" AutomationProperties.Name="Open selected graph node" />
            <TextBlock Grid.Column="2" Text="Ctrl+Shift+L" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="DetailsPanel"
              IsVisible="False"
              Width="310"
              MaxHeight="520"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,82,16,0"
              Padding="17"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              AutomationProperties.Name="Selected node details">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="DetailsNameText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="hud compact" Content="×" Click="OnCloseDetailsClick" AutomationProperties.Name="Close node details" />
          </Grid>
          <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,11" />
          <Grid Grid.Row="2" ColumnDefinitions="78,*" Margin="0,3">
            <TextBlock Text="Type" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock x:Name="DetailsTypeText" Grid.Column="1" />
          </Grid>
          <Grid Grid.Row="3" ColumnDefinitions="78,*" Margin="0,3">
            <TextBlock Text="Size/items" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock x:Name="DetailsSizeText" Grid.Column="1" />
          </Grid>
          <Grid Grid.Row="4" ColumnDefinitions="78,*" Margin="0,3">
            <TextBlock Text="Modified" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock x:Name="DetailsModifiedText" Grid.Column="1" />
          </Grid>
          <Grid Grid.Row="5" ColumnDefinitions="78,*" Margin="0,3">
            <TextBlock Text="Access" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock x:Name="DetailsAccessText" Grid.Column="1" />
          </Grid>
          <StackPanel Grid.Row="6" Margin="0,12,0,0">
            <TextBlock Text="PATH" FontSize="9" LetterSpacing="1.4" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock x:Name="DetailsPathText" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock x:Name="DetailsHintText" Grid.Row="7" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Grid Grid.Row="8" ColumnDefinitions="78,*" Margin="0,10,0,0">
            <TextBlock Text="Index" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock x:Name="DetailsIndexText" Grid.Column="1" Text="—" />
          </Grid>
          <TextBlock x:Name="DetailsSummaryText"
                     Grid.Row="9"
                     Margin="0,10,0,0"
                     MaxHeight="96"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"
                     FontSize="10"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <StackPanel x:Name="RelationshipDetailsSection"
                      Grid.Row="10"
                      IsVisible="False"
                      Margin="0,12,0,0"
                      Spacing="5"
                      AutomationProperties.Name="Selected relationship details">
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,5" />
            <TextBlock Text="RELATED BECAUSE" FontSize="9" LetterSpacing="1.4" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock x:Name="DetailsRelationshipText"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Relationship reason" />
            <Grid ColumnDefinitions="72,*" Margin="0,4,0,0">
              <TextBlock Text="Strength" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock x:Name="DetailsRelationshipStrengthText" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.Name="Relationship ranking strength" />
            </Grid>
            <Grid ColumnDefinitions="72,*">
              <TextBlock Text="Evidence" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock x:Name="DetailsRelationshipEvidenceText" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.Name="Relationship evidence class" />
            </Grid>
            <Grid ColumnDefinitions="72,*">
              <TextBlock Text="Source" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock x:Name="DetailsProvenanceText" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.Name="Relationship provenance" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="SettingsPanel"
              IsVisible="False"
              Width="380"
              MaxHeight="560"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,82,16,0"
              Padding="16"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="SETTINGS" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource AccentBrush}" />
            <Button Grid.Column="1" Classes="hud compact" Content="×" Click="OnSettingsClick" AutomationProperties.Name="Close settings" />
          </Grid>
          <CheckBox x:Name="ReducedMotionToggle"
                    Content="Reduced motion"
                    IsCheckedChanged="OnVisualPreferenceChanged"
                    AutomationProperties.Name="Reduced motion"
                    AutomationProperties.HelpText="Shortens or removes graph and loading movement." />
          <TextBlock Text="Makes navigation state changes immediate and stops decorative movement." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
          <CheckBox x:Name="ReducedEffectsToggle"
                    Content="Reduced visual effects"
                    IsCheckedChanged="OnVisualPreferenceChanged"
                    AutomationProperties.Name="Reduced visual effects"
                    AutomationProperties.HelpText="Reduces glow and decorative background density." />
          <TextBlock Text="Keeps every graph feature while lowering atmospheric and glow cost." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
          <CheckBox x:Name="DiagnosticsToggle"
                    Content="Developer diagnostics"
                    IsCheckedChanged="OnVisualPreferenceChanged"
                    AutomationProperties.Name="Developer diagnostics" />
          <Button x:Name="CopyDiagnosticsButton"
                  Classes="hud"
                  Content="Copy safe diagnostics"
                  Click="OnCopyDiagnosticsClick"
                  AutomationProperties.Name="Copy sanitized support diagnostics"
                  AutomationProperties.HelpText="Copies product, runtime, connection state, bounded counts, and timings without paths, queries, content, endpoints, or session secrets." />
          <TextBlock x:Name="DiagnosticsCopyStatus"
                     FontSize="10"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     AutomationProperties.LiveSetting="Polite" />
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,6" />
          <TextBlock Text="LOCAL VOICE" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource AccentBrush}" />
          <CheckBox x:Name="VoiceEnabledToggle"
                    Content="Voice enabled"
                    IsCheckedChanged="OnVoicePreferenceChanged"
                    AutomationProperties.Name="Enable local push-to-talk voice"
                    AutomationProperties.HelpText="Voice remains optional and records only after explicit activation." />
          <TextBlock Text="Push-to-talk only. Audio is processed locally and is not retained. A user-provided whisper.cpp runtime and GGML model are required."
                     FontSize="10"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock Text="whisper.cpp executable" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBox x:Name="VoiceRuntimePathBox"
                   PlaceholderText="Path to whisper-cli.exe"
                   LostFocus="OnVoiceConfigurationChanged"
                   AutomationProperties.Name="Local speech runtime path" />
          <TextBlock Text="Speech model" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBox x:Name="VoiceModelPathBox"
                   PlaceholderText="Path to a GGML model file"
                   LostFocus="OnVoiceConfigurationChanged"
                   AutomationProperties.Name="Local speech model path" />
          <TextBlock Text="Transcription language" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
          <ComboBox x:Name="VoiceLanguagePicker"
                    Classes="hud"
                    SelectionChanged="OnVoiceLanguageChanged"
                    AutomationProperties.Name="Voice transcription language">
            <ComboBoxItem Content="English" />
            <ComboBoxItem Content="Auto-detect (Search only; commands remain English)" />
          </ComboBox>
          <TextBlock Text="Recommended: whisper.cpp base.en for accuracy or tiny.en for lower latency. Models are never downloaded automatically or bundled into the standard installer."
                     FontSize="10"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="DiagnosticsPanel"
              IsVisible="False"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="16"
              Padding="10,7"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="3">
        <TextBlock x:Name="DiagnosticsText" FontFamily="Cascadia Mono" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
      </Border>

      <Border x:Name="WelcomePanel"
              Width="460"
              Padding="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="5"
              AutomationProperties.Name="First-run guidance">
        <StackPanel HorizontalAlignment="Center" Spacing="12">
          <TextBlock Text="OMNIBRILLE" FontSize="28" FontWeight="Light" LetterSpacing="5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Navigate your information universe" FontSize="16" HorizontalAlignment="Center" />
          <TextBlock Text="Standalone Structure mode reads only the folder you explicitly choose. It does not crawl drives, run in the background, or modify files."
                     TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock x:Name="WelcomeCompanionText"
                     Text="Open OmniBrille from OmniSorSe to explore authorized Context and Hybrid relationships."
                     TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
          <Button x:Name="WelcomeChooseFolderButton"
                  Classes="hud"
                  Margin="0,10,0,0"
                  HorizontalAlignment="Center"
                  Content="Choose folder to explore"
                  Click="OnChooseFolderClick"
                  AutomationProperties.Name="Choose a folder to explore in Standalone mode" />
        </StackPanel>
      </Border>

      <Border x:Name="StructureEmptyPanel"
              IsVisible="False"
              Width="380"
              Padding="20"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="16,0,0,86"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              AutomationProperties.Name="Empty Structure folder">
        <StackPanel Spacing="10">
          <TextBlock Text="THIS FOLDER IS EMPTY" FontSize="10" LetterSpacing="1.4" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="StructureEmptyText"
                     Text="No items were found here."
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="StructureEmptyChooseButton"
                    Classes="hud"
                    Content="Choose another folder"
                    Click="OnChooseFolderClick"
                    AutomationProperties.Name="Choose another Standalone folder" />
            <Button x:Name="StructureEmptyProviderButton"
                    Classes="hud"
                    IsVisible="False"
                    Content="Authorized roots"
                    Click="OnConnectionClick"
                    AutomationProperties.Name="Open authorized OmniSorSe roots" />
            <Button x:Name="StructureEmptyBackButton"
                    Grid.Column="1"
                    Classes="hud"
                    Content="Back"
                    Click="OnBackClick"
                    AutomationProperties.Name="Go back from empty folder" />
          </Grid>
        </StackPanel>
      </Border>

      <Border x:Name="ContextEmptyPanel"
              IsVisible="False"
              Width="360"
              Padding="20"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="16,0,0,86"
              Background="{DynamicResource SurfaceStrongBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              AutomationProperties.Name="Empty Context state">
        <StackPanel Spacing="10">
          <TextBlock Text="NO CONTEXT RELATIONSHIPS" FontSize="10" LetterSpacing="1.4" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="ContextEmptyText" Text="No contextual relationships found for this item." TextWrapping="Wrap" TextAlignment="Center" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="ContextEmptyClearButton" Classes="hud" Content="Clear filters" Click="OnClearContextFiltersClick" AutomationProperties.Name="Clear Context filters from empty state" />
            <Button Grid.Column="1" Classes="hud" Content="Return to Structure" Click="OnStructureModeClick" AutomationProperties.Name="Return to Structure mode" />
          </Grid>
        </StackPanel>
      </Border>

      <Border x:Name="InitialLoadingOverlay" IsVisible="False" Background="{DynamicResource LoadingOverlayBrush}">
        <Grid RowDefinitions="*,Auto,Auto">
          <rendering:DataRainControl x:Name="DataRain" Grid.Row="0" Margin="35" />
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="5" Margin="0,0,0,14">
            <TextBlock Text="BUILDING YOUR UNIVERSE…" LetterSpacing="2" Foreground="{DynamicResource LoadingTextBrush}" />
            <TextBlock x:Name="InitialLoadingText" Text="Opening bounded graph shell" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
          <Grid Grid.Row="2" Margin="48,0,48,30" RowDefinitions="Auto,Auto">
            <ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource AccentBrush}" />
            <Button Grid.Row="1" Classes="hud" Margin="0,12,0,0" HorizontalAlignment="Center" Content="Cancel" Click="OnCancelClick" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceStrongBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <TextBlock x:Name="ViewModeStatusText"
                   Text="STRUCTURE"
                   FontSize="9"
                   LetterSpacing="1.6"
                   Foreground="{DynamicResource AccentBrush}" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Margin="18,0" Text="Choose a folder to begin. Only that location will be accessible."
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Column="2"
                   Text="Backspace back · Ctrl+1/2/3 modes · Ctrl+F search · Ctrl+Shift+L list"
                   FontSize="10"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="Enter opens · Backspace goes back · Ctrl+1/2/3 changes mode · Ctrl+F searches · Ctrl+Shift+L opens the accessible list · Ctrl+Shift+Space toggles voice"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
